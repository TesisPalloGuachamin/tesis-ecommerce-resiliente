# DevOps Foundation - Local Development Environment
# Este archivo debe ser copiado a .env y ajustado según necesidad local
# NOTA: Este compose convive con el docker-compose.yml previo del backend

# ==========================================
# POSTGRES - Core API Database
# ==========================================
POSTGRES_CORE_USER=postgres
POSTGRES_CORE_PASSWORD=postgres
POSTGRES_CORE_DB=core_db
POSTGRES_CORE_PORT=5432
POSTGRES_CORE_HOST=core-db

# ==========================================
# POSTGRES - Checkout Service Database
# ==========================================
POSTGRES_CHECKOUT_USER=postgres
POSTGRES_CHECKOUT_PASSWORD=postgres
POSTGRES_CHECKOUT_DB=checkout_db
POSTGRES_CHECKOUT_PORT=5433
POSTGRES_CHECKOUT_HOST=checkout-db

# ==========================================
# RabbitMQ
# ==========================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Exchange ya definido en backend
RABBITMQ_EXCHANGE=ecommerce.checkout.exchange

# NOTA: Las queues y routing keys específicas deben alinearse con la configuración
# real del backend. Si los nombres no están claros, consultar con la definición
# funcional del servicio de checkout.

# ==========================================
# Core API Service
# ==========================================
CORE_API_PORT=8080
CORE_API_HOST=core-api
CORE_API_LOG_LEVEL=DEBUG
# JWT variables - los valores deben coincidir con los del backend
CORE_API_JWT_SECRET=my-super-secret-key-that-should-be-at-least-32-characters-long-in-production
CORE_API_JWT_EXPIRATION=86400000

# ==========================================
# Checkout Service
# ==========================================
CHECKOUT_SERVICE_PORT=8082
CHECKOUT_SERVICE_HOST=checkout-service
CHECKOUT_SERVICE_LOG_LEVEL=INFO

# ==========================================
# Prometheus
# ==========================================
PROMETHEUS_PORT=9090
PROMETHEUS_HOST=prometheus
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# ==========================================
# Grafana
# ==========================================
GRAFANA_PORT=3000
GRAFANA_HOST=grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_LOG_LEVEL=info

